///|
test "intl plural visible fraction digits en" {
  let options = "en"
  let rules = @plural.PluralRules::cached(options)
  assert_eq(rules.select(1.0), "one")
  assert_eq(rules.select(1.0, visible_fraction_digits=2), "other")
}

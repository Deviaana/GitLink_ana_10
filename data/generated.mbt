    ],
    past: [
      ("zero", "قبل {0} ثانية"),
      ("one", "قبل ثانية واحدة"),
      ("two", "قبل ثانيتين"),
      ("few", "قبل {0} ثوانِ"),
      ("many", "قبل {0} ثانية"),
      ("other", "قبل {0} ثانية"),
    ],
    zero: Some("الآن"),
    one_future: None,
    one_past: None,
  },
}


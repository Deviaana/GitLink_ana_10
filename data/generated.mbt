///|
pub fn number_data(anchor : String) -> NumberData? {
  match anchor {
    "en" => Some(en_numbers)
    "zh" => Some(zh_numbers)
    "de" => Some(de_numbers)
    "ja" => Some(ja_numbers)
    "ar" => Some(ar_numbers)
    "fr" => Some(fr_numbers)
    _ => None
  }
}

///|
pub fn date_data(anchor : String) -> DateData? {
  match anchor {
    "en" => Some(en_dates)
    "zh" => Some(zh_dates)
    "de" => Some(de_dates)
    "ja" => Some(ja_dates)
    "ar" => Some(ar_dates)
    "fr" => Some(fr_dates)
    _ => None
  }
}

///|
pub fn plural_data(anchor : String) -> PluralData? {
  match anchor {
    "en" => Some(en_plurals)
    "zh" => Some(zh_plurals)
    "de" => Some(de_plurals)
    "ja" => Some(ja_plurals)
    "ar" => Some(ar_plurals)
    "fr" => Some(fr_plurals)
    _ => None
  }
}

///|
pub fn relative_data(anchor : String) -> RelativeData? {
  match anchor {
    "en" => Some(en_relative)
    "zh" => Some(zh_relative)
    "de" => Some(de_relative)
    "ja" => Some(ja_relative)
    "ar" => Some(ar_relative)
    "fr" => Some(fr_relative)
    _ => None
  }
}

